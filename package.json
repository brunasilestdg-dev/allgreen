{
  "name": "seu-funcionario",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "verify": "npm run lint && npm test",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vite.config.js",
    "test:worker": "vitest run --config vitest.worker.config.js",
    "deploy": "npm run verify && npm run build && npm run deploy:cloudflare",
    "deploy:cloudflare": "npx wrangler d1 migrations apply seu-funcionario-db --remote && npx wrangler deploy",
    "db:migrate": "npx wrangler d1 migrations apply seu-funcionario-db --remote",
    "test:e2e": "playwright test",
    "test:e2e:acesso": "playwright test e2e/vertical-acesso.spec.js",
    "test:e2e:todogreen": "playwright test e2e/todogreen-smoke.spec.js e2e/todogreen-visual.spec.js e2e/todogreen-roteirizacao.spec.js",
    "track3r:login": "node scripts/track3r-local-bridge/agent.js login",
    "track3r:probe": "node scripts/track3r-local-bridge/agent.js probe",
    "track3r:sync": "node scripts/track3r-local-bridge/agent.js sync",
    "test:visual": "playwright test --config playwright.visual.config.js",
    "test:visual:update": "playwright test --config playwright.visual.config.js --update-snapshots",
    "test:visual:docker": "bash scripts/visual-regression.sh",
    "test:visual:docker:update": "bash scripts/visual-regression.sh --update"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "docx": "^9.7.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.1.200",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "read-excel-file": "^6.0.1",
    "signature_pad": "^5.1.4",
    "tesseract.js": "^7.0.0",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  }
}
