server {
  listen 8080;
  server_name _;
  client_max_body_size 25m;

  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 'ok';
  }

  location = /optimize {
    if ($http_authorization != "Bearer ${ROUTING_TOKEN}") {
      return 401;
    }

    proxy_pass http://vroom:3000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
  }

  location ^~ /osrm/ {
    if ($http_authorization != "Bearer ${ROUTING_TOKEN}") {
      return 401;
    }

    proxy_pass http://osrm:5000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
  }

  location ^~ /nominatim/ {
    if ($http_authorization != "Bearer ${ROUTING_TOKEN}") {
      return 401;
    }

    proxy_pass http://nominatim:8080/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
  }

  # Valhalla (rota de pesados + elevação): mesmo token, mesma máquina.
  location ^~ /valhalla/ {
    if ($http_authorization != "Bearer ${ROUTING_TOKEN}") {
      return 401;
    }

    proxy_pass http://valhalla:8002/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
  }

  location / {
    return 404;
  }
}
