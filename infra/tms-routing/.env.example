# Gere um segredo longo e aleatório. Não comite o valor real.
ROUTING_TOKEN=troque-por-um-segredo-longo-e-aleatorio
NOMINATIM_PASSWORD=troque-por-outro-segredo-longo-e-aleatorio
NOMINATIM_THREADS=4

# Opcional: troque o extrato do OpenStreetMap usado no preparo do OSRM.
# TDG_OSM_PBF_URL=https://download.geofabrik.de/south-america/brazil/sudeste-latest.osm.pbf

# Valhalla (pesados / elevação): threads do servidor. Os tiles usam o mesmo
# TDG_OSM_PBF_URL. No Worker, aponte TDG_VALHALLA_BASE_URL para
# https://<gateway>/valhalla e TDG_ROUTING_TOKEN para o ROUTING_TOKEN acima.
VALHALLA_THREADS=2
