# Copie para `.env` (mesma pasta) e preencha. O `.env` NÃO vai para o Git.

# O domínio que aponta para este servidor. O Caddy emite o certificado sozinho,
# mas só depois que o DNS já estiver resolvendo para cá.
SEARXNG_HOSTNAME=busca.todogreen.com.br

# Assina os cookies de sessão do SearXNG. Gere com:
#   openssl rand -hex 32
SEARXNG_SECRET=

# O que o Worker apresenta para poder consultar. Sem ele, a instância é um
# proxy de busca aberto e o IP do servidor acaba banido no Google. Gere com:
#   openssl rand -hex 32
# O MESMO valor vai para o cofre do Worker como SEARXNG_TOKEN.
SEARXNG_TOKEN=
